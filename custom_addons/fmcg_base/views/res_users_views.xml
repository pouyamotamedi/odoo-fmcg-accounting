<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_fmcg" model="ir.ui.view">
        <field name="name">res.users.form.fmcg</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="FMCG Permissions" name="fmcg_permissions">
                    <group>
                        <group string="Operator Permissions">
                            <field name="fmcg_can_process_sales"/>
                            <field name="fmcg_can_issue_refunds"/>
                            <field name="fmcg_can_modify_inventory"/>
                            <field name="fmcg_can_view_reports"/>
                        </group>
                        <group string="Locale Settings">
                            <field name="fmcg_use_persian_locale"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
