<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Activate IRR currency if it exists but is inactive -->
    <function model="res.currency" name="write">
        <value model="res.currency" search="[('name', '=', 'IRR')]"/>
        <value eval="{'active': True, 'symbol': 'ریال', 'rounding': 1.0}"/>
    </function>
</odoo>
