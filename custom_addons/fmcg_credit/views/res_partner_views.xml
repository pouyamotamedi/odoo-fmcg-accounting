<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Partner Form with Credit Info -->
    <record id="view_partner_form_fmcg_credit" model="ir.ui.view">
        <field name="name">res.partner.form.fmcg.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(action_fmcg_customer_credits)d"
                        icon="fa-credit-card"
                        invisible="fmcg_credit_count == 0">
                    <div class="o_stat_info">
                        <field name="fmcg_total_outstanding" widget="monetary"/>
                        <span class="o_stat_text">Outstanding</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
