<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fmcg_discount_category_tree" model="ir.ui.view">
        <field name="name">fmcg.discount.category.tree</field>
        <field name="model">fmcg.discount.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_fixed_percent"/>
                <field name="fixed_percent"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fmcg_discount_category_form" model="ir.ui.view">
        <field name="name">fmcg.discount.category.form</field>
        <field name="model">fmcg.discount.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_fixed_percent"/>
                        <field name="fixed_percent" invisible="not is_fixed_percent"/>
                        <field name="note"/>
                    </group>
                    <notebook invisible="is_fixed_percent">
                        <page string="قیمت‌های اختصاصی">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="product_list_price"/>
                                    <field name="discount_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fmcg_discount_category" model="ir.actions.act_window">
        <field name="name">دسته‌بندی تخفیفات</field>
        <field name="res_model">fmcg.discount.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fmcg_discount_root" name="تخفیفات" parent="sale.sale_menu_root" sequence="20"/>
    <menuitem id="menu_fmcg_discount_categories" name="دسته‌بندی تخفیفات" parent="menu_fmcg_discount_root" action="action_fmcg_discount_category" sequence="10"/>
</odoo>
