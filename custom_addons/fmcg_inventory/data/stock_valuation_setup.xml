<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!--
        Configure product categories for perpetual (real-time) inventory valuation.
        This ensures purchase invoices debit Stock Interim (Input) instead of Expense,
        and sales properly record Cost of Goods Sold.
        
        Account mapping (searched by code for reliability):
        - Stock Input (interim receipt): code 110100
        - Stock Output (interim delivery): code 110300
        - Stock Valuation: code 110200
        
        Note: noupdate="0" means this runs on every module upgrade,
        ensuring settings are always correct.
    -->

    <!-- Set default product category "All" to real-time FIFO valuation -->
    <!-- Child categories inherit these settings from parent automatically -->
    <record id="product.product_category_all" model="product.category">
        <field name="property_valuation">real_time</field>
        <field name="property_cost_method">fifo</field>
        <field name="property_stock_account_input_categ_id" search="[('code', '=', '110100')]" model="account.account"/>
        <field name="property_stock_account_output_categ_id" search="[('code', '=', '110300')]" model="account.account"/>
        <field name="property_stock_valuation_account_id" search="[('code', '=', '110200')]" model="account.account"/>
    </record>
</odoo>
